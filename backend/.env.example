# AI Content Detector — backend environment
# Copy to backend/.env:  cp backend/.env.example backend/.env
# Every field below is optional; unset fields use the spec defaults shown.

# --- storage ---
DB_PATH=data/app.db
MEDIA_DIR=media/

# --- scan lifecycle ---
SCAN_DEADLINE_S=120
MAX_CONCURRENT_SCANS=2
ENGINE_TIMEOUT_S=30
PURGE_INTERVAL_S=21600
SNAPSHOT_TTL_S=2592000

# --- fetcher caps ---
FETCH_TIMEOUT_S=15
BODY_CAP_MB=10
MAX_REDIRECTS=3
RESPECT_ROBOTS=true

# --- extractor caps ---
MAX_IMAGES=20
TEXT_CAP_BYTES=61440
BLOCK_MIN_CHARS=80
CHUNK_TOKENS=512
IMAGE_MIN_PX=100

# --- verdict bands ---
BAND_UNCLEAR_MIN=35
BAND_SYNTHETIC_MIN=65

# --- API politeness ---
RATE_WINDOW_S=60
RATE_MAX_REQUESTS=30

# --- engines ---
TEXT_ENGINE_ID=text-ai-roberta
IMAGE_ENGINE_ID=image-ai-vit

# --- secrets ---
# IP_SALT is boot-generated (secrets.token_hex(16)) when unset — the app boots
# without it. Set it here for a stable ip_hash across restarts:
# IP_SALT=run-python-c-import-secrets-secrets-token-hex-16
